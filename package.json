{
  "name": "oss-review-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test && vitest run --root scripts",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "check:private": "tsx scripts/check-no-private.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
